{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sendbird/sendbird-client-plugin/core/schemas/credential-check-result.schema.json",
  "title": "Credential check result",
  "description": "Output of core/commands/check-credential.sh.",
  "type": "object",
  "required": ["hit"],
  "additionalProperties": false,
  "properties": {
    "hit": {
      "description": "Comma-joined reasons a secret-shaped pattern matched, or null if none matched. Report-only — never implies the write was blocked.",
      "type": ["string", "null"]
    }
  }
}
