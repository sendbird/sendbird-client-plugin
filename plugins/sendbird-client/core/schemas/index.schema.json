{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sendbird/sendbird-client-plugin/core/schemas/index.schema.json",
  "title": "Curated knowledge index",
  "description": "core/index.json — one entry per knowledge/curated/**/*.md file, generated by tools/curated/build-index.sh. Lets a caller (plugin or CLI) find every curated doc's verification status without grepping the tree itself.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "count", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "platform", "category", "status", "lastVerifiedAgainst", "verifiedDates"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^knowledge/curated/.+\\.md$" },
          "platform": { "type": "string", "enum": ["ios", "android", "js", "common"] },
          "category": { "type": "string" },
          "status": { "type": "string", "enum": ["populated", "scaffold", "unknown"] },
          "lastVerifiedAgainst": { "type": ["string", "null"] },
          "verifiedDates": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        }
      }
    }
  }
}
