{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sendbird/sendbird-client-plugin/core/schemas/detection-result.schema.json",
  "title": "Detection result",
  "description": "Output of core/commands/detect.sh — freshly detected project facts only. Never contains stored/chosen fields such as appId or enabledProducts.",
  "type": "object",
  "required": [
    "platform",
    "host",
    "packageManager",
    "deploymentTarget",
    "lifecycle",
    "interop",
    "existingIntegration",
    "products",
    "legacyMajors",
    "region",
    "schemaVersion",
    "detectedAt",
    "tier2"
  ],
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "js",
        "unknown"
      ]
    },
    "host": {
      "type": "string"
    },
    "packageManager": {
      "type": "string"
    },
    "deploymentTarget": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string"
    },
    "interop": {
      "type": "string"
    },
    "existingIntegration": {
      "type": "object",
      "required": [
        "present",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chat",
          "uikit",
          "ai-agent",
          "desk",
          "calls",
          "live"
        ]
      }
    },
    "legacyMajors": {
      "type": "array",
      "description": "Sendbird SDKs found on an older major version (tools/detection/common/detect-legacy-majors.sh): Chat v3 and UIKit below v3. major is the major the project pins, or, for a package name only an older major used, the last major published under that name. package is the pod, Swift package, Gradle artifact, or npm package that was found. Empty when every detected SDK is on the current major or no version could be read.",
      "items": {
        "type": "object",
        "required": [
          "product",
          "major",
          "package"
        ],
        "additionalProperties": false,
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "chat",
              "uikit",
              "ai-agent",
              "desk",
              "calls",
              "live"
            ]
          },
          "major": {
            "type": "integer",
            "minimum": 0
          },
          "package": {
            "type": "string"
          }
        }
      }
    },
    "region": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tier2": {
      "type": "object",
      "description": "Second-tier facts used for guidance, not routing.",
      "properties": {
        "pushProvider": {
          "type": "string"
        },
        "stateManagement": {
          "type": "string"
        },
        "appIdSource": {
          "description": "JS only: how the App ID is read at runtime. See knowledge/curated/js/setup.md \"App ID\".",
          "enum": [
            "next",
            "expo",
            "vite",
            "cra",
            "config",
            "n/a"
          ]
        }
      },
      "required": [
        "pushProvider",
        "stateManagement",
        "appIdSource"
      ],
      "additionalProperties": false
    }
  }
}
