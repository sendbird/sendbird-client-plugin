<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/values/sendbird_brand.xml
     Same names as uikit/src/main/res/values/colors.xml and sendbird_text_appearance.xml / styles.xml:
     app resources replace library resources of the same name. -->
<resources>
    <!-- Brand palette. primary_300 = primary_main (Light: header buttons, outgoing bubbles),
         primary_200 = primary_light (Dark: outgoing bubbles). -->
    <color name="primary_500">#0B3D91</color>
    <color name="primary_400">#0D52BF</color>
    <color name="primary_300">#1A73E8</color>
    <color name="primary_200">#8AB4F8</color>
    <color name="primary_100">#D2E3FC</color>
    <color name="secondary_300">#188038</color>
    <color name="secondary_200">#81C995</color>

    <!-- Font: each overridden Sendbird* style is replaced as a whole, so keep its other items. -->
    <style name="SendbirdBody3OnDark01">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/ondark_text_high_emphasis</item>
    </style>
    <style name="SendbirdBody3OnLight01">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/onlight_text_high_emphasis</item>
    </style>

    <!-- Outgoing text color only in user-message bubbles (Light). The redefined style replaces
         UIKit's Widget.Sendbird.Message.Me.User as a whole, so every item is copied. -->
    <style name="BrandMyMessageText" parent="SendbirdBody3OnDark01">
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="Widget.Sendbird.Message.Me.User">
        <item name="sb_message_me_text_appearance">@style/BrandMyMessageText</item>
        <item name="sb_message_me_background">@drawable/sb_shape_chat_bubble</item>
        <item name="sb_message_me_background_tint">@color/sb_message_me_tint_light</item>
        <item name="sb_message_me_ogtag_background">@drawable/sb_message_og_background</item>
        <item name="sb_message_me_ogtag_background_tint">@color/sb_message_other_tint_light</item>
        <item name="sb_message_me_link_text_color">@color/ondark_text_high_emphasis</item>
        <item name="sb_message_me_clicked_link_background_color">@color/primary_dark</item>
        <item name="sb_message_my_edited_mark_text_appearance">@style/SendbirdBody3OnDark02</item>
        <item name="sb_message_my_mentioned_text_appearance">@style/SendbirdMentionLightMe</item>
        <item name="sb_message_mentioned_current_user_text_background">@color/highlight</item>
        <item name="sb_message_mentioned_current_user_text_appearance">@style/MentionedCurrentUserMessage</item>
    </style>
</resources>
