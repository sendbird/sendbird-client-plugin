{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/welcome.sh\"",
            "statusMessage": "Sendbird Client plugin: session rules"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/first-run-notice.sh\" start",
            "statusMessage": "Sendbird Client plugin: one-time notice — its hooks run local scripts; nothing is sent to Sendbird"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/first-run-notice.sh\" prompt",
            "statusMessage": "Sendbird Client plugin: one-time notice — its hooks run local scripts; nothing is sent to Sendbird"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.sh\" prompt",
            "statusMessage": "Sendbird Client plugin: note pasted tokens (hashes only)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/first-run-notice.sh\" tool",
            "statusMessage": "Sendbird Client plugin: one-time notice — its hooks run local scripts; nothing is sent to Sendbird"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/credential-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: block credentials in writes"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: confirm destructive Sendbird CLI commands"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/build-command-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: no project builds during plugin work unless you asked for one"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/source-claim-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: block unsourced Sendbird API code"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/token-relay-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: keep pasted tokens out of agent briefs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.sh\" tool",
            "statusMessage": "Sendbird Client plugin: note the skill steps this turn ran"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/upgrade-sdk-guard.sh\"",
            "statusMessage": "Sendbird Client plugin: read the upgrade rules before the hand-off"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-start.sh\"",
            "statusMessage": "Sendbird Client plugin: local telemetry (opt-in)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.sh\" agent-start",
            "statusMessage": "Sendbird Client plugin: track running agents"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-end.sh\"",
            "statusMessage": "Sendbird Client plugin: local telemetry (opt-in)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/unsourced-claim-warn.sh\"",
            "statusMessage": "Sendbird Client plugin: check agent answer sources"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.sh\" agent-stop",
            "statusMessage": "Sendbird Client plugin: keep the agent report for the final answer check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/final-answer-gate.sh\"",
            "statusMessage": "Sendbird Client plugin: check final answer sources"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-summary-gate.sh\"",
            "statusMessage": "Sendbird Client plugin: check run summary (non-interactive)"
          }
        ]
      }
    ]
  }
}
